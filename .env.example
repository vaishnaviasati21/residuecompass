# ── Database ──────────────────────────────────────────────────────────────
# Local: postgresql://rc:rc_pass@localhost:5432/residue
# Docker: postgresql://rc:rc_pass@db:5432/residue
DATABASE_URL=postgresql://rc:rc_pass@localhost:5432/residue

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth ──────────────────────────────────────────────────────────────────
# REQUIRED: Generate a >= 32-char secret before running:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_32_plus_char_random_hex_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Feature flags ─────────────────────────────────────────────────────────
# Production must set DEMO_MODE=false. Set true only for isolated demos.
DEMO_MODE=false

# ── Notifications ─────────────────────────────────────────────────────────
# Options: log | twilio_sms | twilio_whatsapp
NOTIFIER_CHANNEL=log

# Twilio credentials (leave blank when NOTIFIER_CHANNEL=log)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# SMS: +1XXXXXXXXXX   WhatsApp sandbox: +14155238886
TWILIO_FROM_NUMBER=

# ── CORS ──────────────────────────────────────────────────────────────────
# "*" is fine for the demo.  For production list exact origins:
# CORS_ORIGINS=https://your-frontend.com,https://admin.your-domain.com
CORS_ORIGINS=*
