# ── Database ──────────────────────────────────────────────────────────────
# REQUIRED: set all three. Never commit real credentials.
# Generate a URL: postgresql://<user>:<pass>@<host>:5432/<db>
DATABASE_URL=

# Match docker-compose service name when running in Docker:
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=residue

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Auth ──────────────────────────────────────────────────────────────────
# REQUIRED: generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Must be >= 32 chars. Known placeholders will cause startup to abort.
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Feature flags ─────────────────────────────────────────────────────────
# Production MUST keep this false. Set true ONLY for isolated demos.
DEMO_MODE=false

# ── Notifications ─────────────────────────────────────────────────────────
# Options: log | twilio_sms | twilio_whatsapp
NOTIFIER_CHANNEL=log

# Twilio credentials (leave blank when NOTIFIER_CHANNEL=log)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── CORS ──────────────────────────────────────────────────────────────────
# REQUIRED for production: comma-separated list of allowed origins.
# "*" is NEVER accepted in production mode.
# Example: CORS_ORIGINS=https://your-frontend.com,https://admin.example.com
CORS_ORIGINS=

# ── Scheduler ─────────────────────────────────────────────────────────────
# Standard cron expression for the harvest refresh beat task.
# Default: 2 AM UTC every day.  During harvest season: "0 2 * 10,11 *"
HARVEST_REFRESH_CRON=0 2 * * *
